      "gold": {"expected_supported": false, "expected_abstain": true, "expected_source_role": "independent", "as_of": "2026-07-01", "max_age_days": 365}
    },
    {
      "id": "technical-429",
      "system_input": {"query": "Report the independent current battery density as of 2026-07-01.", "evidence": "The battery density is 400 Wh/kg.", "source_role": "independent", "date": "2026-07-01"},
      "system_mutation": "verifier_429",
      "gold": {"expected_supported": false, "expected_abstain": true, "expected_source_role": "independent", "as_of": "2026-07-01", "max_age_days": 365}
    },
    {
      "id": "technical-5xx-partial",
      "system_input": {"query": "Report the independent current battery density as of 2026-07-01.", "evidence": "The battery density is 400 Wh/kg.", "source_role": "independent", "date": "2026-07-01"},
      "system_mutation": "verifier_5xx_partial",
      "gold": {"expected_supported": false, "expected_abstain": true, "expected_source_role": "independent", "as_of": "2026-07-01", "max_age_days": 365}
    }
  ]
}

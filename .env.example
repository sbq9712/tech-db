# Copy this file to .env. Never commit .env or real secrets.
ZAI_API_KEY=replace-with-your-own-key
ZAI_API_BASE=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.2

# Explicit deployment migration profile. runtime-v1 currently supplies the
# legacy indexes/model. Do not select manifest until a complete validated
# catalog has passed the shadow/canary activation gate in MIGRATION.md.
TECH_DB_RUNTIME_MODE=legacy_hybrid
QA_PIPELINE_PROFILE=legacy_hybrid

# Public-service anti-abuse defaults (all are configurable).
QA_RATE_LIMIT_PER_MINUTE=3
QA_RATE_LIMIT_PER_DAY=30
QA_GLOBAL_LIMIT_PER_DAY=300
QA_MAX_CONCURRENCY=3

# Set a positive amount to enable the daily estimated-cost fuse.
QA_DAILY_BUDGET_USD=0
QA_ESTIMATED_REQUEST_COST_USD=0.02
QA_ADMIN_KEY=replace-with-a-long-random-admin-key

# Comma-separated allowed browser origins.
QA_CORS_ORIGINS=https://sbq9712.github.io,http://localhost:8000,http://localhost:8097

[Unit]
Description=tech-db: vector index incremental rebuild (embeds new records)
After=techdb-data-sync.service
Wants=techdb-data-sync.service

[Service]
Type=oneshot
WorkingDirectory=/home/rhett/tech-db-fresh
ExecStart=/home/rhett/tech-db-fresh/.venv/bin/python -u /home/rhett/tech-db-fresh/qa-backend/vector_index.py
ExecStartPost=/bin/bash -c '/usr/bin/curl -sf http://localhost:8765/api/health >/dev/null && systemctl --user try-restart techdb-server.service || true'
TimeoutStartSec=6h
